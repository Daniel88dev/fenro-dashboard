# Public origin of the app. Better Auth builds the OAuth callback from it, so it
# must match the "Authorization callback URL" of the GitHub OAuth app:
# ${APP_URL}/api/auth/callback/github
APP_URL=http://localhost:3000

# Postgres connection string. `docker compose up -d` starts a local one that
# matches this value; `pnpm db:migrate` creates the tables.
DATABASE_URL=postgres://fenro:fenro@localhost:5432/fenro

# Signs session cookies and encrypts stored GitHub tokens. At least 32
# characters: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=

# The GitHub OAuth app used for "Sign in with GitHub".
# Create one at https://github.com/settings/developers.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional fallback token for reading GitHub. Signed-in viewers use their own
# OAuth token instead; leave this empty unless you need it.
GITHUB_TOKEN=
