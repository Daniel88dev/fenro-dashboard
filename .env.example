# Public origin of the app. Better Auth builds the OAuth callback from it, so it
# must match the "Callback URL" of the GitHub App:
# ${APP_URL}/api/auth/callback/github
APP_URL=http://localhost:3000

# Postgres connection string. `docker compose up -d` starts a local one that
# matches this value; `pnpm db:migrate` creates the tables, all in the `fenro`
# schema. In production this is Flexi Day's RDS database, reached as the
# `fenro` role (README, "Database"):
#   postgresql://fenro:<password>@<rds address>:5432/flexiday?sslmode=verify-full
DATABASE_URL=postgres://fenro:fenro@localhost:5432/fenro

# A throwaway Postgres for the database adapter tests. They migrate it and
# empty its tables, so never reuse DATABASE_URL here. Vitest does not read
# this file: export it in the shell to run those tests, or leave it unset to
# skip them. With `docker compose up -d`:
#   docker compose exec postgres createdb -U fenro fenro_test
#   TEST_DATABASE_URL=postgres://fenro:fenro@localhost:5432/fenro_test pnpm test
TEST_DATABASE_URL=

# Signs session cookies and encrypts stored GitHub tokens. At least 32
# characters: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=

# The GitHub App used for "Sign in with GitHub" (README, "Signing in with
# GitHub"). Create one at https://github.com/settings/apps/new. GITHUB_APP_SLUG
# is its URL name, github.com/apps/<slug>, for the link that installs it on
# more repositories.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=

# Optional fallback token for reading GitHub. Signed-in viewers use their own
# GitHub token instead; leave this empty unless you need it.
GITHUB_TOKEN=

# Pictures on tasks are kept in a private S3 bucket. These values match the
# S3 stand-in `docker compose up -d` starts. Empty PICTURES_S3_BUCKET runs
# without pictures. In production only the bucket and region are set: the app
# signs in to S3 with the App Runner instance role, so no keys exist there.
PICTURES_S3_BUCKET=fenro-pictures
PICTURES_S3_REGION=eu-central-1
PICTURES_S3_ENDPOINT=http://localhost:9090
PICTURES_S3_ACCESS_KEY_ID=fenro
PICTURES_S3_SECRET_ACCESS_KEY=fenro

# Where pictures were kept before S3. Read only while PICTURES_S3_BUCKET is
# empty; it goes once production's pictures are copied to S3.
UPLOADTHING_TOKEN=
