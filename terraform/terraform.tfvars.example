# Copy to terraform.tfvars (gitignored) and fill in. That file holds live
# secret values; so does terraform.tfstate, whatever way the values arrive
# (TF_VAR_* included).

aws_region   = "eu-central-1" # same region as flexi-day-be's RDS
environment  = "production"
project_name = "fenro-dashboard"

# FIRST ROLLOUT (README): leave both false for the first apply, set
# create_service once CI has pushed the first image, then
# manage_dns_validation_records after the apply that created the service.
create_service                = false
manage_dns_validation_records = false

# BARE DOMAIN REDIRECT (README, Domain): once the image with src/proxy.ts is
# deployed, set redirect_bare_domain, apply, then the validation records.
redirect_bare_domain                  = false
manage_bare_domain_validation_records = false

ecr_repository_name      = "daniel88dev/fenro-dashboard"
docker_image_tag         = "latest"
app_port                 = 3000
apprunner_cpu            = "256"
apprunner_memory         = "512"
apprunner_max_size       = 1     # raise only with a shared Next.js cache handler
auto_deployments_enabled = false # the pipeline calls start-deployment instead

# Register the domain in the Route 53 console first; that creates the zone.
domain_name = "fenro-dashboard.com"

rds_instance_identifier = "flexi-day-be-production-db"
db_name                 = "flexiday"
db_role                 = "fenro"

# GitHub Actions deploy role. Subjects are relative to the repository:
# "ref:refs/heads/main" is the main branch, "ref:refs/tags/v*" release tags,
# "environment:production" a job using that GitHub environment.
# GitHub sends this repository's subject as owner@owner_id/name@repo_id, so
# that spelling is trusted too.
github_repository           = "Daniel88dev/fenro-dashboard"
github_repository_immutable = "Daniel88dev@64728456/fenro-dashboard@1377254182"
github_deploy_subjects      = ["ref:refs/heads/main"]

# Production GitHub App (public values). Its callback URL must be
#   https://www.fenro-dashboard.com/api/auth/callback/github
github_client_id = ""
github_app_slug  = ""

# The free plan holds 5M spans a month: lower the rate if Usage shows spans
# running out.
sentry_dsn                = ""
sentry_traces_sample_rate = 1

# better_auth_secret: `openssl rand -base64 32`. It encrypts the stored GitHub
# tokens; changing it makes every stored token unreadable and signs everybody
# out.
better_auth_secret = ""

# github_client_secret: a client secret generated in the production GitHub App.
github_client_secret = ""

pictures_noncurrent_days = 30
